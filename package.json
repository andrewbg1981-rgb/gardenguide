{
  "name": "gardenguide",
  "version": "0.1.0",
  "private": true,
  "description": "GardenGuide v1: a gardening task schedule",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate-data && vite build",
    "preview": "vite preview",
    "test": "node --test --test-reporter=spec \"src/**/*.test.ts\"",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json",
    "convert-data": "node scripts/run-python.mjs scripts/convert_data.py",
    "validate-data": "node scripts/validate-data.ts"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@fontsource/lato": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
